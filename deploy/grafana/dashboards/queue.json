    {
      "id": 9,
      "type": "timeseries",
      "title": "Admission ticks by result (per second)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (rate(holdfast_queue_admission_ticks_total[1m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "T0 openings and opener passes",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (by) (increase(holdfast_queue_opened_total[5m]))",
          "legendFormat": "opened by {{by}} (5m)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (rate(holdfast_queue_opener_runs_total[1m]))",
          "legendFormat": "opener {{result}}/s"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "HTTP p99 latency by route (queue-svc)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(holdfast_http_request_duration_seconds_bucket{job=\"queue\"}[1m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "HTTP responses by status (queue-svc, per second)",
      "datasource": {
        "type": "prometheus",
