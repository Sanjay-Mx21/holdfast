# Settings for running services on the host (`make run-inventory`).
# Copy to .env and adjust. .env is git-ignored; never commit real secrets.
ENVIRONMENT=development
LOG_LEVEL=info
LOG_FORMAT=text

HTTP_ADDR=:8080
ADMIN_ADDR=:9090
HTTP_REQUEST_TIMEOUT=5s
SHUTDOWN_DRAIN_DELAY=5s

VALKEY_ADDRS=localhost:6379
POSTGRES_DSN=postgres://holdfast:holdfast@localhost:5432/holdfast?sslmode=disable

ADMISSION_PUBLIC_KEY_FILES=.local/keys/admission.pub
ADMIN_TOKEN=dev-only-admin-token-change-me-0123456789

HOLD_TTL=5m
PAYMENT_WINDOW=10m
SWEEP_INTERVAL=500ms
SWEEP_BATCH=500
