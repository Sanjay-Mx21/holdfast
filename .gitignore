# Build and test output
/bin/
/dist/
*.exe
*.test
*.out
*.prof
*.pprof
coverage.*
e1-results.json
__debug_bin*
/vendor/

# Local secrets and dev keys (generated by `make keys`). Never commit these.
/.local/
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# Local overrides of the Compose stack
compose.override.yaml
compose.override.yml

# Logs and scratch files. Experiment evidence in loadtest/results/ is committed,
# including its .log files (build plan 17.3).
*.log
!/loadtest/results/*.log
/tmp/
*.tmp

# Web app (Phase 4: web/, Next.js)
node_modules/
.next/
/web/out/
*.tsbuildinfo
next-env.d.ts
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Release archives
/*.zip

# Workspace files
go.work
go.work.sum
.idea/
.vscode/
*.swp
*~
.claude/settings.local.json

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Office lock files (e.g. holdfast-build-status.xlsx while it is open)
~$*
